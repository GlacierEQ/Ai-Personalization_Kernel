{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/correction.schema.json",
  "title": "Correction",
  "description": "Structured correction record (spec section 8.1) that mutates action-policy scoring rather than merely being logged as prose.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["behavior_correction", "authority_correction", "preference_correction"]
    },
    "pattern": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["global", "project", "domain", "conversation"] },
    "desired_behavior": { "type": "string", "minLength": 1 },
    "undesired_behavior": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recurrence_count": { "type": "integer", "minimum": 1 },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "promotion_level": {
      "type": "string",
      "enum": ["observation", "preference", "strong_preference", "procedural_rule", "invariant"]
    },
    "status": { "type": "string", "enum": ["active", "superseded", "resolved"] },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "array", "items": { "type": "string" } },
    "related_patterns": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "id", "type", "pattern", "scope", "desired_behavior", "undesired_behavior",
    "confidence", "recurrence_count", "first_seen", "last_seen", "promotion_level",
    "status", "source_refs", "supersedes", "superseded_by", "related_patterns"
  ],
  "additionalProperties": false
}
